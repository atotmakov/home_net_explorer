# NAS deploy config — copy to .env.deploy and fill in your values (used by deploy.ps1)
NAS_HOST=192.168.1.x                              # IP or hostname of your Synology NAS
NAS_USER=admin                                    # SSH user on the NAS
NAS_DIR=/volume1/docker/home-net-explorer         # Directory on NAS to deploy to
SSH_KEY=~/.ssh/id_rsa                             # Path to SSH private key (leave empty to use ssh-agent)
IMAGE=ghcr.io/atotmakov/home_net_explorer:latest  # Docker image to pull (override if needed)
IMAGE_PLATFORM=linux/amd64                        # NAS CPU: linux/amd64 (Intel/AMD) or linux/arm64
IMAGE_ARCHIVE=home-net-explorer.tar.gz                # Local image archive: used if present, else pulled from GitHub
HNE_PORT=8080                                     # Port of the web UI on the NAS (host networking)
HNE_SUBNETS=                                      # Optional: comma-separated private subnets for the NAS to scan (needed if its netmask is wider than /22)
